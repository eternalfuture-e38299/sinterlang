// Sinter JSON library: parser and serializer, implemented in Sinter.
//
// The document is stored as a flat node pool.  Every node has a kind, an
// optional text payload, and a contiguous range of child nodes; object
// members additionally carry a key.  This keeps recursive values free of
// nested ownership and makes serialization a plain tree walk.
//
//     import json
//
//     val doc = Json()
//     if doc.parse(readText("data.json")) {
//         val root = doc.root()
//         println(doc.getString(doc.get(root, "name"), ""))
//         println(doc.compact())
//     }
//
//     val out = Json()
//     val obj = out.objectValue()
//     out.putString(obj, "name", "sinter")
//     println(out.compact())
module json

import std
import std.text
import std.string
import std.list

// Node kinds.
const JSON_NULL: i64 = 0
const JSON_BOOL: i64 = 1
const JSON_INT: i64 = 2
const JSON_FLOAT: i64 = 3
const JSON_STRING: i64 = 4
const JSON_ARRAY: i64 = 5
const JSON_OBJECT: i64 = 6

fun isDigit(c: i64): bool => c >= 48 && c <= 57

fun hexVal(c: i64): i64 {
    if c >= 48 && c <= 57 { ret c - 48 }
    if c >= 65 && c <= 70 { ret c - 55 }
    if c >= 97 && c <= 102 { ret c - 87 }
    ret -1
}

fun appendUtf8(sb: StringBuilder, cp: i64): void {
    if cp <= 127 {
        sb.appendByte((cp % 256) as u8)
    } else if cp <= 2047 {
        sb.appendByte((192 + cp / 64) as u8)
        sb.appendByte((128 + cp % 64) as u8)
    } else if cp <= 65535 {
        sb.appendByte((224 + cp / 4096) as u8)
        sb.appendByte((128 + (cp / 64) % 64) as u8)
        sb.appendByte((128 + cp % 64) as u8)
    } else {
        sb.appendByte((240 + cp / 262144) as u8)
        sb.appendByte((128 + (cp / 4096) % 64) as u8)
        sb.appendByte((128 + (cp / 64) % 64) as u8)
        sb.appendByte((128 + cp % 64) as u8)
    }
}

fun appendHex4(sb: StringBuilder, v: i64): void {
    val digits = "0123456789abcdef"
    sb.appendByte((digits.at((v / 4096) % 16)) as u8)
    sb.appendByte((digits.at((v / 256) % 16)) as u8)
    sb.appendByte((digits.at((v / 16) % 16)) as u8)
    sb.appendByte((digits.at(v % 16)) as u8)
}

fun writeIndent(sb: StringBuilder, depth: i64, spaces: i64): void {
    var i: i64 = 0
    while i < depth * spaces {
        sb.appendByte(32u8)
        i = i + 1
    }
}

class JsonParser {
    var text: str
    var pos: i64
    var len: i64
    var ok: bool

    JsonParser(input: str) {
        self.text = input
        self.pos = 0
        self.len = input.length()
        self.ok = true
    }

    fun skipWs(): void {
        while self.pos < self.len {
            val c = self.text.at(self.pos)
            if c == 32 || c == 9 || c == 10 || c == 13 {
                self.pos = self.pos + 1
            } else {
                ret
            }
        }
    }

    fun take(expect: i64): bool {
        if self.pos < self.len && self.text.at(self.pos) == expect {
            self.pos = self.pos + 1
            ret true
        }
        ret false
    }

    fun lit(word: str): bool {
        if self.pos + word.length() > self.len { ret false }
        if self.text.substring(self.pos, self.pos + word.length()) != word { ret false }
        self.pos = self.pos + word.length()
        ret true
    }

    fun parseString(): str {
        if !self.take(34) { self.ok = false; ret "" }
        val sb = StringBuilder()
        while self.pos < self.len {
            val c = self.text.at(self.pos)
            if c == 34 {
                self.pos = self.pos + 1
                ret sb.toString()
            }
            if c != 92 {
                sb.appendByte((c % 256) as u8)
                self.pos = self.pos + 1
            } else {
                self.pos = self.pos + 1
                if self.pos >= self.len { self.ok = false; ret "" }
                val e = self.text.at(self.pos)
                self.pos = self.pos + 1
                if e == 34 { sb.appendByte(34u8) }
                else if e == 92 { sb.appendByte(92u8) }
                else if e == 47 { sb.appendByte(47u8) }
                else if e == 98 { sb.appendByte(8u8) }
                else if e == 102 { sb.appendByte(12u8) }
                else if e == 110 { sb.appendByte(10u8) }
                else if e == 114 { sb.appendByte(13u8) }
                else if e == 116 { sb.appendByte(9u8) }
                else if e == 117 {
                    var cp: i64 = 0
                    var k: i64 = 0
                    while k < 4 {
                        if self.pos >= self.len { self.ok = false; ret "" }
                        val h = hexVal(self.text.at(self.pos))
                        if h < 0 { self.ok = false; ret "" }
                        cp = cp * 16 + h
                        self.pos = self.pos + 1
                        k = k + 1
                    }
                    if cp >= 55296 && cp <= 56319 {
                        if self.pos + 6 <= self.len && self.text.at(self.pos) == 92 && self.text.at(self.pos + 1) == 117 {
                            self.pos = self.pos + 2
                            var lo: i64 = 0
                            k = 0
                            while k < 4 {
                                val h = hexVal(self.text.at(self.pos))
                                if h < 0 { self.ok = false; ret "" }
                                lo = lo * 16 + h
                                self.pos = self.pos + 1
                                k = k + 1
                            }
                            if lo >= 56320 && lo <= 57343 {
                                cp = 65536 + (cp - 55296) * 1024 + (lo - 56320)
                            } else {
                                self.ok = false
                                ret ""
                            }
                        }
                    }
                    appendUtf8(sb, cp)
                } else {
                    self.ok = false
                    ret ""
                }
            }
        }
        self.ok = false
        ret ""
    }

    fun parseNumber(doc: Json): i64 {
        val start = self.pos
        if self.pos < self.len && self.text.at(self.pos) == 45 { self.pos = self.pos + 1 }
        var digits: i64 = 0
        while self.pos < self.len && isDigit(self.text.at(self.pos)) {
            self.pos = self.pos + 1
            digits = digits + 1
        }
        if digits == 0 { self.ok = false; ret -1 }
        var isFloat = false
        if self.pos < self.len && self.text.at(self.pos) == 46 {
            isFloat = true
            self.pos = self.pos + 1
            var frac: i64 = 0
            while self.pos < self.len && isDigit(self.text.at(self.pos)) {
                self.pos = self.pos + 1
                frac = frac + 1
            }
            if frac == 0 { self.ok = false; ret -1 }
        }
        if self.pos < self.len {
            val e = self.text.at(self.pos)
            if e == 101 || e == 69 {
                isFloat = true
                self.pos = self.pos + 1
                if self.pos < self.len {
                    val sign = self.text.at(self.pos)
                    if sign == 43 || sign == 45 { self.pos = self.pos + 1 }
                }
                var ed: i64 = 0
                while self.pos < self.len && isDigit(self.text.at(self.pos)) {
                    self.pos = self.pos + 1
                    ed = ed + 1
                }
                if ed == 0 { self.ok = false; ret -1 }
            }
        }
        val raw = self.text.substring(start, self.pos)
        if isFloat {
            val node = doc.addNode(JSON_FLOAT)
            doc.setText(node, raw)
            doc.setFloat(node, raw.toFloat())
            ret node
        }
        val node = doc.addNode(JSON_INT)
        doc.setText(node, raw)
        doc.setInt(node, raw.toLong())
        ret node
    }

    fun parseArray(doc: Json): i64 {
        val node = doc.addNode(JSON_ARRAY)
        self.pos = self.pos + 1
        self.skipWs()
        if self.take(93) { ret node }
        while true {
            self.skipWs()
            val v = self.parseValue(doc)
            if v < 0 { ret -1 }
            doc.addChild(node, v)
            self.skipWs()
            if self.take(44) { continue }
            if self.take(93) { ret node }
            self.ok = false
            ret -1
        }
        ret -1
    }

    fun parseObject(doc: Json): i64 {
        val node = doc.addNode(JSON_OBJECT)
        self.pos = self.pos + 1
        self.skipWs()
        if self.take(125) { ret node }
        while true {
            self.skipWs()
            if self.pos >= self.len || self.text.at(self.pos) != 34 {
                self.ok = false
                ret -1
            }
            val key = self.parseString()
            if !self.ok { ret -1 }
            self.skipWs()
            if !self.take(58) { self.ok = false; ret -1 }
            self.skipWs()
            val v = self.parseValue(doc)
            if v < 0 { ret -1 }
            doc.setKey(v, key)
            doc.addChild(node, v)
            self.skipWs()
            if self.take(44) { continue }
            if self.take(125) { ret node }
            self.ok = false
            ret -1
        }
        ret -1
    }

    fun parseValue(doc: Json): i64 {
        self.skipWs()
        if self.pos >= self.len { self.ok = false; ret -1 }
        val c = self.text.at(self.pos)
        if c == 123 { ret self.parseObject(doc) }
        if c == 91 { ret self.parseArray(doc) }
        if c == 34 {
            val node = doc.addNode(JSON_STRING)
            val v = self.parseString()
            if !self.ok { ret -1 }
            doc.setText(node, v)
            ret node
        }
        if c == 116 {
            if !self.lit("true") { self.ok = false; ret -1 }
            val node = doc.addNode(JSON_BOOL)
            doc.setInt(node, 1)
            ret node
        }
        if c == 102 {
            if !self.lit("false") { self.ok = false; ret -1 }
            val node = doc.addNode(JSON_BOOL)
            doc.setInt(node, 0)
            ret node
        }
        if c == 110 {
            if !self.lit("null") { self.ok = false; ret -1 }
            ret doc.addNode(JSON_NULL)
        }
        if c == 45 || isDigit(c) { ret self.parseNumber(doc) }
        self.ok = false
        ret -1
    }

    fun run(doc: Json): bool {
        doc.clear()
        val root = self.parseValue(doc)
        if root < 0 || !self.ok { ret false }
        self.skipWs()
        if self.pos != self.len { ret false }
        ret true
    }
}

/// JSON document: a node pool plus parse/serialize helpers.
pub class Json {
    var kinds: List<i64>
    var texts: List<str>
    var ints: List<i64>
    var floats: List<f64>
    var firstchild: List<i64>
    var nextsibling: List<i64>
    var counts: List<i64>
    var keys: List<str>

    Json() {
        self.kinds = List<i64>()
        self.texts = List<str>()
        self.ints = List<i64>()
        self.floats = List<f64>()
        self.firstchild = List<i64>()
        self.nextsibling = List<i64>()
        self.counts = List<i64>()
        self.keys = List<str>()
    }

    fun clear(): void {
        self.kinds.clear()
        self.texts.clear()
        self.ints.clear()
        self.floats.clear()
        self.firstchild.clear()
        self.nextsibling.clear()
        self.counts.clear()
        self.keys.clear()
    }

    fun addNode(kind: i64): i64 {
        val node = self.kinds.size()
        self.kinds.add(kind)
        self.texts.add("")
        self.ints.add(0)
        self.floats.add(0.0)
        self.firstchild.add(-1)
        self.nextsibling.add(-1)
        self.counts.add(0)
        self.keys.add("")
        ret node
    }

    fun addChild(parent: i64, child: i64): void {
        val n = self.counts.get(parent)
        if n == 0 {
            self.firstchild.set(parent, child)
        } else {
            var at = self.firstchild.get(parent)
            while self.nextsibling.get(at) >= 0 {
                at = self.nextsibling.get(at)
            }
            self.nextsibling.set(at, child)
        }
        self.counts.set(parent, n + 1)
    }

    fun setText(node: i64, v: str): void => self.texts.set(node, v)
    fun setInt(node: i64, v: i64): void => self.ints.set(node, v)
    fun setFloat(node: i64, v: f64): void => self.floats.set(node, v)
    fun setKey(node: i64, v: str): void => self.keys.set(node, v)

    /// Parse `text`; replaces the current document. Returns false on any error.
    pub fun parse(text: str): bool {
        val parser = JsonParser(text)
        if !parser.run(self) {
            self.clear()
            ret false
        }
        ret true
    }

    pub fun isValid(): bool => self.kinds.size() > 0
    pub fun root(): i64 {
        if self.kinds.size() == 0 { ret -1 }
        ret 0
    }

    pub fun kind(node: i64): i64 => self.kinds.get(node)
    pub fun size(node: i64): i64 => self.counts.get(node)
    pub fun indexAt(node: i64, i: i64): i64 {
        var at = self.firstchild.get(node)
        var k: i64 = 0
        while k < i {
            at = self.nextsibling.get(at)
            k = k + 1
        }
        ret at
    }
    pub fun keyAt(node: i64, i: i64): str => self.keys.get(self.indexAt(node, i))

    pub fun isNull(node: i64): bool => self.kind(node) == JSON_NULL
    pub fun isBool(node: i64): bool => self.kind(node) == JSON_BOOL
    pub fun isInt(node: i64): bool => self.kind(node) == JSON_INT
    pub fun isFloat(node: i64): bool => self.kind(node) == JSON_FLOAT
    pub fun isNumber(node: i64): bool => self.kind(node) == JSON_INT || self.kind(node) == JSON_FLOAT
    pub fun isString(node: i64): bool => self.kind(node) == JSON_STRING
    pub fun isArray(node: i64): bool => self.kind(node) == JSON_ARRAY
    pub fun isObject(node: i64): bool => self.kind(node) == JSON_OBJECT

    pub fun asBool(node: i64): bool => self.ints.get(node) != 0
    pub fun asInt(node: i64): i64 {
        if self.kind(node) == JSON_INT { ret self.ints.get(node) }
        ret self.texts.get(node).toLong()
    }
    pub fun asFloat(node: i64): f64 => self.texts.get(node).toFloat()
    pub fun asString(node: i64): str => self.texts.get(node)

    /// First child of an object with `key`, or -1.
    pub fun get(node: i64, key: str): i64 {
        if !self.isObject(node) { ret -1 }
        val n = self.counts.get(node)
        var at = self.firstchild.get(node)
        var i: i64 = 0
        while i < n {
            if self.keys.get(at) == key { ret at }
            at = self.nextsibling.get(at)
            i = i + 1
        }
        ret -1
    }

    pub fun getString(node: i64, key: str, fallback: str): str {
        val at = self.get(node, key)
        if at < 0 { ret fallback }
        ret self.asString(at)
    }
    pub fun getInt(node: i64, key: str, fallback: i64): i64 {
        val at = self.get(node, key)
        if at < 0 { ret fallback }
        ret self.asInt(at)
    }
    pub fun getFloat(node: i64, key: str, fallback: f64): f64 {
        val at = self.get(node, key)
        if at < 0 { ret fallback }
        ret self.asFloat(at)
    }
    pub fun getBool(node: i64, key: str, fallback: bool): bool {
        val at = self.get(node, key)
        if at < 0 { ret fallback }
        ret self.asBool(at)
    }

    // ---- builders ----
    pub fun nullValue(): i64 => self.addNode(JSON_NULL)
    pub fun boolValue(v: bool): i64 {
        val n = self.addNode(JSON_BOOL)
        if v { self.ints.set(n, 1) }
        ret n
    }
    pub fun intValue(v: i64): i64 {
        val n = self.addNode(JSON_INT)
        self.ints.set(n, v)
        self.texts.set(n, fromInt(v))
        ret n
    }
    pub fun floatValue(v: f64): i64 {
        val n = self.addNode(JSON_FLOAT)
        self.floats.set(n, v)
        self.texts.set(n, fromFloat(v))
        ret n
    }
    pub fun stringValue(v: str): i64 {
        val n = self.addNode(JSON_STRING)
        self.texts.set(n, v)
        ret n
    }
    pub fun arrayValue(): i64 => self.addNode(JSON_ARRAY)
    pub fun objectValue(): i64 => self.addNode(JSON_OBJECT)

    pub fun add(parent: i64, child: i64): i64 {
        self.addChild(parent, child)
        ret child
    }
    pub fun put(parent: i64, key: str, child: i64): i64 {
        self.keys.set(child, key)
        self.addChild(parent, child)
        ret child
    }
    pub fun addString(parent: i64, v: str): i64 => self.add(parent, self.stringValue(v))
    pub fun addInt(parent: i64, v: i64): i64 => self.add(parent, self.intValue(v))
    pub fun addFloat(parent: i64, v: f64): i64 => self.add(parent, self.floatValue(v))
    pub fun addBool(parent: i64, v: bool): i64 => self.add(parent, self.boolValue(v))
    pub fun addNull(parent: i64): i64 => self.add(parent, self.nullValue())
    pub fun putString(parent: i64, key: str, v: str): i64 => self.put(parent, key, self.stringValue(v))
    pub fun putInt(parent: i64, key: str, v: i64): i64 => self.put(parent, key, self.intValue(v))
    pub fun putBool(parent: i64, key: str, v: bool): i64 => self.put(parent, key, self.boolValue(v))
    pub fun putFloat(parent: i64, key: str, v: f64): i64 => self.put(parent, key, self.floatValue(v))

    fun writeString(s: str, sb: StringBuilder): void {
        sb.appendByte(34u8)
        var i: i64 = 0
        while i < s.length() {
            val c = s.at(i)
            if c == 34 { sb.append("\\\"") }
            else if c == 92 { sb.append("\\\\") }
            else if c == 10 { sb.append("\\n") }
            else if c == 13 { sb.append("\\r") }
            else if c == 9 { sb.append("\\t") }
            else if c == 8 { sb.append("\\b") }
            else if c == 12 { sb.append("\\f") }
            else if c < 32 {
                sb.append("\\u")
                appendHex4(sb, c)
            } else {
                sb.appendByte((c % 256) as u8)
            }
            i = i + 1
        }
        sb.appendByte(34u8)
    }

    fun writeValue(node: i64, sb: StringBuilder, pretty: bool, depth: i64, spaces: i64): void {
        val k = self.kinds.get(node)
        if k == JSON_NULL { sb.append("null"); ret }
        if k == JSON_BOOL {
            if self.ints.get(node) != 0 { sb.append("true") } else { sb.append("false") }
            ret
        }
        if k == JSON_INT || k == JSON_FLOAT {
            sb.append(self.texts.get(node))
            ret
        }
        if k == JSON_STRING {
            self.writeString(self.texts.get(node), sb)
            ret
        }
        if k == JSON_ARRAY {
            val n = self.counts.get(node)
            if n == 0 { sb.append("[]"); ret }
            sb.appendByte(91u8)
            var i: i64 = 0
            while i < n {
                if i > 0 { sb.appendByte(44u8) }
                if pretty {
                    sb.appendByte(10u8)
                    writeIndent(sb, depth + 1, spaces)
                }
                self.writeValue(self.indexAt(node, i), sb, pretty, depth + 1, spaces)
                i = i + 1
            }
            if pretty {
                sb.appendByte(10u8)
                writeIndent(sb, depth, spaces)
            }
            sb.appendByte(93u8)
            ret
        }
        if k == JSON_OBJECT {
            val n = self.counts.get(node)
            if n == 0 { sb.append("{}"); ret }
            sb.appendByte(123u8)
            var i: i64 = 0
            while i < n {
                if i > 0 { sb.appendByte(44u8) }
                if pretty {
                    sb.appendByte(10u8)
                    writeIndent(sb, depth + 1, spaces)
                }
                val child = self.indexAt(node, i)
                self.writeString(self.keys.get(child), sb)
                sb.appendByte(58u8)
                if pretty { sb.appendByte(32u8) }
                self.writeValue(child, sb, pretty, depth + 1, spaces)
                i = i + 1
            }
            if pretty {
                sb.appendByte(10u8)
                writeIndent(sb, depth, spaces)
            }
            sb.appendByte(125u8)
            ret
        }
        sb.append("null")
    }

    /// Compact JSON for the whole document.
    pub fun compact(): str {
        val sb = StringBuilder()
        val root = self.root()
        if root >= 0 { self.writeValue(root, sb, false, 0, 2) }
        ret sb.toString()
    }

    /// Pretty JSON with two spaces per level.
    pub fun pretty(): str => self.prettyWith(2)

    /// Pretty JSON with `indent` spaces per level (indent is normalized to 2 steps).
    pub fun prettyWith(indent: i64): str {
        val sb = StringBuilder()
        val root = self.root()
        if root >= 0 { self.writeValue(root, sb, true, 0, indent) }
        ret sb.toString()
    }
}
