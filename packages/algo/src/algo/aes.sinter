// Sinter algorithm library: AES-128/192/256 block cipher, CBC and CTR.
// Self-contained C implementation (FIPS-197); no OpenSSL / mbedTLS.
//
//     import algo.aes
//
//     val cipher = aesCbcEncrypt(key, iv, plain)   // PKCS#7 padded
//     val plain2 = aesCbcDecrypt(key, iv, cipher)
module algo.aes

import std

embed C {
    #include <stdint.h>
    #include <stdlib.h>
    #include <string.h>

    static const uint8_t sinter_aes_sbox[256] = {
        0x63,0x7c,0x77,0x7b,0xf2,0x6b,0x6f,0xc5,0x30,0x01,0x67,0x2b,0xfe,0xd7,0xab,0x76,
        0xca,0x82,0xc9,0x7d,0xfa,0x59,0x47,0xf0,0xad,0xd4,0xa2,0xaf,0x9c,0xa4,0x72,0xc0,
        0xb7,0xfd,0x93,0x26,0x36,0x3f,0xf7,0xcc,0x34,0xa5,0xe5,0xf1,0x71,0xd8,0x31,0x15,
        0x04,0xc7,0x23,0xc3,0x18,0x96,0x05,0x9a,0x07,0x12,0x80,0xe2,0xeb,0x27,0xb2,0x75,
        0x09,0x83,0x2c,0x1a,0x1b,0x6e,0x5a,0xa0,0x52,0x3b,0xd6,0xb3,0x29,0xe3,0x2f,0x84,
        0x53,0xd1,0x00,0xed,0x20,0xfc,0xb1,0x5b,0x6a,0xcb,0xbe,0x39,0x4a,0x4c,0x58,0xcf,
        0xd0,0xef,0xaa,0xfb,0x43,0x4d,0x33,0x85,0x45,0xf9,0x02,0x7f,0x50,0x3c,0x9f,0xa8,
        0x51,0xa3,0x40,0x8f,0x92,0x9d,0x38,0xf5,0xbc,0xb6,0xda,0x21,0x10,0xff,0xf3,0xd2,
        0xcd,0x0c,0x13,0xec,0x5f,0x97,0x44,0x17,0xc4,0xa7,0x7e,0x3d,0x64,0x5d,0x19,0x73,
        0x60,0x81,0x4f,0xdc,0x22,0x2a,0x90,0x88,0x46,0xee,0xb8,0x14,0xde,0x5e,0x0b,0xdb,
        0xe0,0x32,0x3a,0x0a,0x49,0x06,0x24,0x5c,0xc2,0xd3,0xac,0x62,0x91,0x95,0xe4,0x79,
        0xe7,0xc8,0x37,0x6d,0x8d,0xd5,0x4e,0xa9,0x6c,0x56,0xf4,0xea,0x65,0x7a,0xae,0x08,
        0xba,0x78,0x25,0x2e,0x1c,0xa6,0xb4,0xc6,0xe8,0xdd,0x74,0x1f,0x4b,0xbd,0x8b,0x8a,
        0x70,0x3e,0xb5,0x66,0x48,0x03,0xf6,0x0e,0x61,0x35,0x57,0xb9,0x86,0xc1,0x1d,0x9e,
        0xe1,0xf8,0x98,0x11,0x69,0xd9,0x8e,0x94,0x9b,0x1e,0x87,0xe9,0xce,0x55,0x28,0xdf,
        0x8c,0xa1,0x89,0x0d,0xbf,0xe6,0x42,0x68,0x41,0x99,0x2d,0x0f,0xb0,0x54,0xbb,0x16
    };

    static const uint8_t sinter_aes_rsbox[256] = {
        0x52,0x09,0x6a,0xd5,0x30,0x36,0xa5,0x38,0xbf,0x40,0xa3,0x9e,0x81,0xf3,0xd7,0xfb,
        0x7c,0xe3,0x39,0x82,0x9b,0x2f,0xff,0x87,0x34,0x8e,0x43,0x44,0xc4,0xde,0xe9,0xcb,
        0x54,0x7b,0x94,0x32,0xa6,0xc2,0x23,0x3d,0xee,0x4c,0x95,0x0b,0x42,0xfa,0xc3,0x4e,
        0x08,0x2e,0xa1,0x66,0x28,0xd9,0x24,0xb2,0x76,0x5b,0xa2,0x49,0x6d,0x8b,0xd1,0x25,
        0x72,0xf8,0xf6,0x64,0x86,0x68,0x98,0x16,0xd4,0xa4,0x5c,0xcc,0x5d,0x65,0xb6,0x92,
        0x6c,0x70,0x48,0x50,0xfd,0xed,0xb9,0xda,0x5e,0x15,0x46,0x57,0xa7,0x8d,0x9d,0x84,
        0x90,0xd8,0xab,0x00,0x8c,0xbc,0xd3,0x0a,0xf7,0xe4,0x58,0x05,0xb8,0xb3,0x45,0x06,
        0xd0,0x2c,0x1e,0x8f,0xca,0x3f,0x0f,0x02,0xc1,0xaf,0xbd,0x03,0x01,0x13,0x8a,0x6b,
        0x3a,0x91,0x11,0x41,0x4f,0x67,0xdc,0xea,0x97,0xf2,0xcf,0xce,0xf0,0xb4,0xe6,0x73,
        0x96,0xac,0x74,0x22,0xe7,0xad,0x35,0x85,0xe2,0xf9,0x37,0xe8,0x1c,0x75,0xdf,0x6e,
        0x47,0xf1,0x1a,0x71,0x1d,0x29,0xc5,0x89,0x6f,0xb7,0x62,0x0e,0xaa,0x18,0xbe,0x1b,
        0xfc,0x56,0x3e,0x4b,0xc6,0xd2,0x79,0x20,0x9a,0xdb,0xc0,0xfe,0x78,0xcd,0x5a,0xf4,
        0x1f,0xdd,0xa8,0x33,0x88,0x07,0xc7,0x31,0xb1,0x12,0x10,0x59,0x27,0x80,0xec,0x5f,
        0x60,0x51,0x7f,0xa9,0x19,0xb5,0x4a,0x0d,0x2d,0xe5,0x7a,0x9f,0x93,0xc9,0x9c,0xef,
        0xa0,0xe0,0x3b,0x4d,0xae,0x2a,0xf5,0xb0,0xc8,0xeb,0xbb,0x3c,0x83,0x53,0x99,0x61,
        0x17,0x2b,0x04,0x7e,0xba,0x77,0xd6,0x26,0xe1,0x69,0x14,0x63,0x55,0x21,0x0c,0x7d
    };

    typedef struct { uint8_t rk[240]; int nr; } sinter_aes_ctx;

    static uint8_t sinter_aes_xtime(uint8_t x) {
        return (uint8_t)((x << 1) ^ ((x & 0x80) ? 0x1b : 0x00));
    }
    static uint8_t sinter_aes_mul(uint8_t a, uint8_t b) {
        uint8_t r = 0;
        while (b) {
            if (b & 1) r ^= a;
            a = sinter_aes_xtime(a);
            b >>= 1;
        }
        return r;
    }

    static int sinter_aes_init(sinter_aes_ctx* c, sinter_string key) {
        if (!c || key.len != 16 && key.len != 24 && key.len != 32) return 0;
        const int nk = (int)key.len / 4;
        c->nr = nk + 6;
        const int total = 4 * (c->nr + 1);
        memcpy(c->rk, key.data, (size_t)key.len);
        uint8_t rcon = 1;
        for (int i = nk; i < total; ++i) {
            uint8_t t[4];
            memcpy(t, c->rk + (i - 1) * 4, 4);
            if (i % nk == 0) {
                uint8_t tmp = t[0];
                t[0] = sinter_aes_sbox[t[1]] ^ rcon;
                t[1] = sinter_aes_sbox[t[2]];
                t[2] = sinter_aes_sbox[t[3]];
                t[3] = sinter_aes_sbox[tmp];
                rcon = sinter_aes_xtime(rcon);
            } else if (nk > 6 && i % nk == 4) {
                for (int j = 0; j < 4; ++j) t[j] = sinter_aes_sbox[t[j]];
            }
            for (int j = 0; j < 4; ++j)
                c->rk[i * 4 + j] = (uint8_t)(c->rk[(i - nk) * 4 + j] ^ t[j]);
        }
        return 1;
    }

    static void sinter_aes_add_round_key(uint8_t* s, const uint8_t* rk) {
        for (int i = 0; i < 16; ++i) s[i] ^= rk[i];
    }
    static void sinter_aes_sub(uint8_t* s, const uint8_t* box) {
        for (int i = 0; i < 16; ++i) s[i] = box[s[i]];
    }
    static void sinter_aes_shift(uint8_t* s) {
        uint8_t t[16];
        for (int r = 1; r < 4; ++r)
            for (int c = 0; c < 4; ++c)
                t[c * 4 + r] = s[((c + r) % 4) * 4 + r];
        for (int r = 1; r < 4; ++r)
            for (int c = 0; c < 4; ++c)
                s[c * 4 + r] = t[c * 4 + r];
    }
    static void sinter_aes_inv_shift(uint8_t* s) {
        uint8_t t[16];
        for (int r = 1; r < 4; ++r)
            for (int c = 0; c < 4; ++c)
                t[((c + r) % 4) * 4 + r] = s[c * 4 + r];
        for (int r = 1; r < 4; ++r)
            for (int c = 0; c < 4; ++c)
                s[c * 4 + r] = t[c * 4 + r];
    }
    static void sinter_aes_mix(uint8_t* s) {
        for (int c = 0; c < 4; ++c) {
            uint8_t* a = s + c * 4;
            uint8_t t = (uint8_t)(a[0] ^ a[1] ^ a[2] ^ a[3]);
            uint8_t a0 = a[0];
            a[0] ^= (uint8_t)(t ^ sinter_aes_xtime((uint8_t)(a[0] ^ a[1])));
            a[1] ^= (uint8_t)(t ^ sinter_aes_xtime((uint8_t)(a[1] ^ a[2])));
            a[2] ^= (uint8_t)(t ^ sinter_aes_xtime((uint8_t)(a[2] ^ a[3])));
            a[3] ^= (uint8_t)(t ^ sinter_aes_xtime((uint8_t)(a[3] ^ a0)));
        }
    }
    static void sinter_aes_inv_mix(uint8_t* s) {
        for (int c = 0; c < 4; ++c) {
            uint8_t* a = s + c * 4;
            uint8_t a0 = a[0], a1 = a[1], a2 = a[2], a3 = a[3];
            a[0] = (uint8_t)(sinter_aes_mul(a0,14) ^ sinter_aes_mul(a1,11) ^
                             sinter_aes_mul(a2,13) ^ sinter_aes_mul(a3,9));
            a[1] = (uint8_t)(sinter_aes_mul(a0,9) ^ sinter_aes_mul(a1,14) ^
                             sinter_aes_mul(a2,11) ^ sinter_aes_mul(a3,13));
            a[2] = (uint8_t)(sinter_aes_mul(a0,13) ^ sinter_aes_mul(a1,9) ^
                             sinter_aes_mul(a2,14) ^ sinter_aes_mul(a3,11));
            a[3] = (uint8_t)(sinter_aes_mul(a0,11) ^ sinter_aes_mul(a1,13) ^
                             sinter_aes_mul(a2,9) ^ sinter_aes_mul(a3,14));
        }
    }
    static void sinter_aes_encrypt_block(const sinter_aes_ctx* c, const uint8_t* in, uint8_t* out) {
        uint8_t s[16];
        memcpy(s, in, 16);
        sinter_aes_add_round_key(s, c->rk);
        for (int r = 1; r < c->nr; ++r) {
            sinter_aes_sub(s, sinter_aes_sbox);
            sinter_aes_shift(s);
            sinter_aes_mix(s);
            sinter_aes_add_round_key(s, c->rk + r * 16);
        }
        sinter_aes_sub(s, sinter_aes_sbox);
        sinter_aes_shift(s);
        sinter_aes_add_round_key(s, c->rk + c->nr * 16);
        memcpy(out, s, 16);
    }
    static void sinter_aes_decrypt_block(const sinter_aes_ctx* c, const uint8_t* in, uint8_t* out) {
        uint8_t s[16];
        memcpy(s, in, 16);
        sinter_aes_add_round_key(s, c->rk + c->nr * 16);
        for (int r = c->nr - 1; r > 0; --r) {
            sinter_aes_inv_shift(s);
            sinter_aes_sub(s, sinter_aes_rsbox);
            sinter_aes_add_round_key(s, c->rk + r * 16);
            sinter_aes_inv_mix(s);
        }
        sinter_aes_inv_shift(s);
        sinter_aes_sub(s, sinter_aes_rsbox);
        sinter_aes_add_round_key(s, c->rk);
        memcpy(out, s, 16);
    }

    static sinter_string sinter_aes_block_encrypt(sinter_string key, sinter_string block) {
        if (block.len != 16) return sinter_string_from_literal("", 0);
        sinter_aes_ctx c;
        if (!sinter_aes_init(&c, key)) return sinter_string_from_literal("", 0);
        uint8_t out[16];
        sinter_aes_encrypt_block(&c, (const uint8_t*)block.data, out);
        return sinter_string_from_buf((const char*)out, 16);
    }
    static sinter_string sinter_aes_block_decrypt(sinter_string key, sinter_string block) {
        if (block.len != 16) return sinter_string_from_literal("", 0);
        sinter_aes_ctx c;
        if (!sinter_aes_init(&c, key)) return sinter_string_from_literal("", 0);
        uint8_t out[16];
        sinter_aes_decrypt_block(&c, (const uint8_t*)block.data, out);
        return sinter_string_from_buf((const char*)out, 16);
    }

    static sinter_string sinter_aes_cbc_encrypt(sinter_string key, sinter_string iv, sinter_string p) {
        if (iv.len != 16) return sinter_string_from_literal("", 0);
        sinter_aes_ctx c;
        if (!sinter_aes_init(&c, key)) return sinter_string_from_literal("", 0);
        const int64_t pad = 16 - (p.len % 16);
        const int64_t n = p.len + pad;
        uint8_t* out = (uint8_t*)malloc((size_t)n);
        if (!out) return sinter_string_from_literal("", 0);
        uint8_t prev[16];
        memcpy(prev, iv.data, 16);
        for (int64_t off = 0; off < n; off += 16) {
            uint8_t block[16];
            for (int j = 0; j < 16; ++j) {
                uint8_t v = (off + j < p.len) ? (uint8_t)p.data[off + j] : (uint8_t)pad;
                block[j] = (uint8_t)(v ^ prev[j]);
            }
            sinter_aes_encrypt_block(&c, block, out + off);
            memcpy(prev, out + off, 16);
        }
        sinter_string r = sinter_string_from_buf((const char*)out, n);
        free(out);
        return r;
    }
    static sinter_string sinter_aes_cbc_decrypt(sinter_string key, sinter_string iv, sinter_string c) {
        if (iv.len != 16 || c.len == 0 || c.len % 16 != 0)
            return sinter_string_from_literal("", 0);
        sinter_aes_ctx ctx;
        if (!sinter_aes_init(&ctx, key)) return sinter_string_from_literal("", 0);
        uint8_t* out = (uint8_t*)malloc((size_t)c.len);
        if (!out) return sinter_string_from_literal("", 0);
        uint8_t prev[16];
        memcpy(prev, iv.data, 16);
        for (int64_t off = 0; off < c.len; off += 16) {
            uint8_t block[16];
            sinter_aes_decrypt_block(&ctx, (const uint8_t*)c.data + off, block);
            for (int j = 0; j < 16; ++j) out[off + j] = (uint8_t)(block[j] ^ prev[j]);
            memcpy(prev, c.data + off, 16);
        }
        const uint8_t pad = out[c.len - 1];
        if (pad == 0 || pad > 16 || pad > c.len) { free(out); return sinter_string_from_literal("", 0); }
        for (int j = 0; j < pad; ++j)
            if (out[c.len - 1 - j] != pad) { free(out); return sinter_string_from_literal("", 0); }
        sinter_string r = sinter_string_from_buf((const char*)out, c.len - pad);
        free(out);
        return r;
    }

    static sinter_string sinter_aes_ctr(sinter_string key, sinter_string iv, sinter_string p) {
        if (iv.len != 16) return sinter_string_from_literal("", 0);
        sinter_aes_ctx c;
        if (!sinter_aes_init(&c, key)) return sinter_string_from_literal("", 0);
        if (p.len == 0) return sinter_string_from_literal("", 0);
        uint8_t* out = (uint8_t*)malloc((size_t)p.len);
        if (!out) return sinter_string_from_literal("", 0);
        uint8_t counter[16], stream[16];
        memcpy(counter, iv.data, 16);
        for (int64_t off = 0; off < p.len; off += 16) {
            sinter_aes_encrypt_block(&c, counter, stream);
            for (int j = 0; j < 16 && off + j < p.len; ++j)
                out[off + j] = (uint8_t)(p.data[off + j] ^ stream[j]);
            for (int j = 15; j >= 0; --j) {
                if (++counter[j] != 0) break;
            }
        }
        sinter_string r = sinter_string_from_buf((const char*)out, p.len);
        free(out);
        return r;
    }
}

/// Encrypt one 16-byte block. Key must be 16/24/32 bytes.
pub fun aesBlockEncrypt(key: str, block: str): str => sinter_aes_block_encrypt(key, block)
pub fun aesBlockDecrypt(key: str, block: str): str => sinter_aes_block_decrypt(key, block)

/// AES-CBC with PKCS#7 padding. IV must be 16 bytes.
pub fun aesCbcEncrypt(key: str, iv: str, plain: str): str => sinter_aes_cbc_encrypt(key, iv, plain)
pub fun aesCbcDecrypt(key: str, iv: str, cipher: str): str => sinter_aes_cbc_decrypt(key, iv, cipher)

/// AES-CTR (no padding; encrypt and decrypt are the same operation).
pub fun aesCtr(key: str, iv: str, data: str): str => sinter_aes_ctr(key, iv, data)
