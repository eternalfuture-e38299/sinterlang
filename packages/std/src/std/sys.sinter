// Sinter low-level OS primitives used by independent libraries such as net.
// These are thin syscall wrappers; the algorithms stay in Cinder modules.
module std.sys

import std

embed C {
#ifdef _WIN32
    #include <winsock2.h>
    #include <ws2tcpip.h>
    #include <windows.h>
    #include <stdio.h>
    #include <stdlib.h>
    #include <string.h>
    typedef SOCKET sinter_net_socket_t;
    typedef int sinter_net_ssize_t;
    #define SINTER_NET_INVALID INVALID_SOCKET
    #define SINTER_NET_EINTR WSAEINTR
    #define SINTER_NET_ERRNO WSAGetLastError()
    #define MSG_NOSIGNAL 0
    static int sinter_net_ready(void) {
        static int started = 0;
        if (!started) {
            WSADATA w;
            if (WSAStartup(MAKEWORD(2, 2), &w) != 0) return -1;
            started = 1;
        }
        return 0;
    }
    static void sinter_net_close_sock(sinter_net_socket_t s) {
        if (s != INVALID_SOCKET) closesocket(s);
    }
    static void sinter_net_no_sigpipe(sinter_net_socket_t s) { (void)s; }
#else
    #ifndef _POSIX_C_SOURCE
    #define _POSIX_C_SOURCE 200112L
    #endif
    #include <sys/types.h>
    #include <sys/socket.h>
    #include <sys/time.h>
    #include <netdb.h>
    #include <netinet/in.h>
    #include <arpa/inet.h>
    #include <unistd.h>
    #include <errno.h>
    #include <stdio.h>
    #include <stdlib.h>
    #include <string.h>
    typedef int sinter_net_socket_t;
    typedef ssize_t sinter_net_ssize_t;
    #define SINTER_NET_INVALID (-1)
    #define SINTER_NET_EINTR EINTR
    #define SINTER_NET_ERRNO errno
    #ifndef MSG_NOSIGNAL
    #define MSG_NOSIGNAL 0
    #endif
    static int sinter_net_ready(void) { return 0; }
    static void sinter_net_close_sock(sinter_net_socket_t s) {
        if (s >= 0) close(s);
    }
    static void sinter_net_no_sigpipe(sinter_net_socket_t s) {
#ifdef SO_NOSIGPIPE
        int one = 1;
        setsockopt(s, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof(one));
#else
        (void)s;
#endif
    }
#endif

    static int64_t sinter_net_tcp_listen(sinter_string host, int64_t port, int64_t backlog) {
        if (sinter_net_ready() != 0) return -1;
        struct addrinfo hints, *res = NULL;
        memset(&hints, 0, sizeof(hints));
        hints.ai_family = AF_UNSPEC;
        hints.ai_socktype = SOCK_STREAM;
        hints.ai_flags = AI_PASSIVE;
        char portbuf[16];
        snprintf(portbuf, sizeof(portbuf), "%lld", (long long)port);
        const char* node = host.len > 0 ? sinter_string_to_cstr(host) : NULL;
        if (getaddrinfo(node, portbuf, &hints, &res) != 0) return -1;
        int64_t fd = -1;
        for (struct addrinfo* ai = res; ai; ai = ai->ai_next) {
            sinter_net_socket_t s = socket(ai->ai_family, ai->ai_socktype, ai->ai_protocol);
            if (s == SINTER_NET_INVALID) continue;
            int one = 1;
            setsockopt(s, SOL_SOCKET, SO_REUSEADDR, (const char*)&one, sizeof(one));
            if (bind(s, ai->ai_addr, (int)ai->ai_addrlen) == 0 &&
                listen(s, (int)(backlog > 0 ? backlog : 16)) == 0) {
                fd = (int64_t)s;
                break;
            }
            sinter_net_close_sock(s);
        }
        freeaddrinfo(res);
        return fd;
    }

    static int64_t sinter_net_tcp_connect(sinter_string host, int64_t port) {
        if (sinter_net_ready() != 0) return -1;
        struct addrinfo hints, *res = NULL;
        memset(&hints, 0, sizeof(hints));
        hints.ai_family = AF_UNSPEC;
        hints.ai_socktype = SOCK_STREAM;
        char portbuf[16];
        snprintf(portbuf, sizeof(portbuf), "%lld", (long long)port);
        const char* node = sinter_string_to_cstr(host);
        if (getaddrinfo(node, portbuf, &hints, &res) != 0) return -1;
        int64_t fd = -1;
        for (struct addrinfo* ai = res; ai; ai = ai->ai_next) {
            sinter_net_socket_t s = socket(ai->ai_family, ai->ai_socktype, ai->ai_protocol);
            if (s == SINTER_NET_INVALID) continue;
            if (connect(s, ai->ai_addr, (int)ai->ai_addrlen) == 0) {
                sinter_net_no_sigpipe(s);
                fd = (int64_t)s;
                break;
            }
            sinter_net_close_sock(s);
        }
        freeaddrinfo(res);
        return fd;
    }

    static int64_t sinter_net_tcp_accept(int64_t fd) {
        for (;;) {
            sinter_net_socket_t s = accept((sinter_net_socket_t)fd, NULL, NULL);
            if (s != SINTER_NET_INVALID) {
                sinter_net_no_sigpipe(s);
                return (int64_t)s;
            }
            if (SINTER_NET_ERRNO != SINTER_NET_EINTR) return -1;
        }
    }

    static int64_t sinter_net_send(int64_t fd, sinter_string data) {
        const char* p = data.data;
        int64_t left = data.len, sent = 0;
        while (left > 0) {
            sinter_net_ssize_t n = send((sinter_net_socket_t)fd, p, (int)left, MSG_NOSIGNAL);
            if (n < 0) {
                if (SINTER_NET_ERRNO == SINTER_NET_EINTR) continue;
                return sent > 0 ? sent : -1;
            }
            p += n;
            left -= (int64_t)n;
            sent += (int64_t)n;
        }
        return sent;
    }

    static sinter_string sinter_net_recv(int64_t fd, int64_t max_bytes) {
        if (max_bytes <= 0) max_bytes = 4096;
        char* buf = (char*)malloc((size_t)max_bytes);
        if (!buf) return sinter_string_from_literal("", 0);
        sinter_net_ssize_t n;
        do {
            n = recv((sinter_net_socket_t)fd, buf, (int)max_bytes, 0);
        } while (n < 0 && SINTER_NET_ERRNO == SINTER_NET_EINTR);
        if (n <= 0) { free(buf); return sinter_string_from_literal("", 0); }
        sinter_string out = sinter_string_from_buf(buf, (int64_t)n);
        free(buf);
        return out;
    }

    static sinter_string sinter_net_recv_all(int64_t fd, int64_t max_bytes) {
        int64_t cap = 4096, len = 0;
        if (max_bytes > 0 && max_bytes < cap) cap = max_bytes;
        char* buf = (char*)malloc((size_t)cap + 1);
        if (!buf) return sinter_string_from_literal("", 0);
        for (;;) {
            if (max_bytes > 0 && len >= max_bytes) break;
            int64_t room = cap - len;
            if (max_bytes > 0 && max_bytes - len < room) room = max_bytes - len;
            if (room <= 0) break;
            sinter_net_ssize_t n = recv((sinter_net_socket_t)fd, buf + len, (int)room, 0);
            if (n < 0) {
                if (SINTER_NET_ERRNO == SINTER_NET_EINTR) continue;
                break;
            }
            if (n == 0) break;
            len += (int64_t)n;
            if (len == cap && (max_bytes <= 0 || cap < max_bytes)) {
                int64_t ncap = cap * 2;
                if (max_bytes > 0 && ncap > max_bytes) ncap = max_bytes;
                char* p = (char*)realloc(buf, (size_t)ncap + 1);
                if (!p) break;
                buf = p;
                cap = ncap;
            }
        }
        sinter_string out = sinter_string_from_buf(buf, len);
        free(buf);
        return out;
    }

    static sinter_string sinter_net_recv_line(int64_t fd) {
        int64_t cap = 256, len = 0;
        char* buf = (char*)malloc((size_t)cap + 1);
        if (!buf) return sinter_string_from_literal("", 0);
        for (;;) {
            char ch;
            sinter_net_ssize_t n = recv((sinter_net_socket_t)fd, &ch, 1, 0);
            if (n < 0) {
                if (SINTER_NET_ERRNO == SINTER_NET_EINTR) continue;
                break;
            }
            if (n == 0) break;
            if (ch == '\n') break;
            if (ch == '\r') continue;
            if (len == cap) {
                char* p = (char*)realloc(buf, (size_t)(cap * 2) + 1);
                if (!p) break;
                buf = p;
                cap *= 2;
            }
            buf[len++] = ch;
        }
        sinter_string out = sinter_string_from_buf(buf, len);
        free(buf);
        return out;
    }

    static void sinter_net_close(int64_t fd) {
        if (fd >= 0) sinter_net_close_sock((sinter_net_socket_t)fd);
    }

    static void sinter_net_shutdown(int64_t fd) {
#ifdef _WIN32
        if (fd >= 0) shutdown((SOCKET)fd, SD_BOTH);
#else
        if (fd >= 0) shutdown((int)fd, SHUT_RDWR);
#endif
    }

    static int64_t sinter_net_set_timeout(int64_t fd, int64_t ms) {
#ifdef _WIN32
        DWORD tv = (DWORD)(ms < 0 ? 0 : ms);
        if (setsockopt((SOCKET)fd, SOL_SOCKET, SO_RCVTIMEO, (const char*)&tv, sizeof(tv)) != 0) return 0;
        if (setsockopt((SOCKET)fd, SOL_SOCKET, SO_SNDTIMEO, (const char*)&tv, sizeof(tv)) != 0) return 0;
#else
        struct timeval tv;
        tv.tv_sec = (time_t)(ms / 1000);
        tv.tv_usec = (suseconds_t)((ms % 1000) * 1000);
        if (setsockopt((int)fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv)) != 0) return 0;
        if (setsockopt((int)fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv)) != 0) return 0;
#endif
        return 1;
    }

    static int64_t sinter_net_local_port(int64_t fd) {
        struct sockaddr_storage ss;
        socklen_t slen = sizeof(ss);
        if (getsockname((sinter_net_socket_t)fd, (struct sockaddr*)&ss, &slen) != 0) return -1;
        if (ss.ss_family == AF_INET)
            return (int64_t)ntohs(((struct sockaddr_in*)&ss)->sin_port);
        if (ss.ss_family == AF_INET6)
            return (int64_t)ntohs(((struct sockaddr_in6*)&ss)->sin6_port);
        return -1;
    }

    static sinter_string sinter_net_last_error(void) {
#ifdef _WIN32
        char buf[64];
        int n = snprintf(buf, sizeof(buf), "winsock error %d", (int)WSAGetLastError());
        return sinter_string_from_buf(buf, n);
#else
        return sinter_string_from_cstr(strerror(errno));
#endif
    }

    static int64_t sinter_net_udp_bind(sinter_string host, int64_t port) {
        if (sinter_net_ready() != 0) return -1;
        struct addrinfo hints, *res = NULL;
        memset(&hints, 0, sizeof(hints));
        hints.ai_family = AF_UNSPEC;
        hints.ai_socktype = SOCK_DGRAM;
        hints.ai_flags = AI_PASSIVE;
        char portbuf[16];
        snprintf(portbuf, sizeof(portbuf), "%lld", (long long)port);
        const char* node = host.len > 0 ? sinter_string_to_cstr(host) : NULL;
        if (getaddrinfo(node, portbuf, &hints, &res) != 0) return -1;
        int64_t fd = -1;
        for (struct addrinfo* ai = res; ai; ai = ai->ai_next) {
            sinter_net_socket_t s = socket(ai->ai_family, ai->ai_socktype, ai->ai_protocol);
            if (s == SINTER_NET_INVALID) continue;
            if (bind(s, ai->ai_addr, (int)ai->ai_addrlen) == 0) { fd = (int64_t)s; break; }
            sinter_net_close_sock(s);
        }
        freeaddrinfo(res);
        return fd;
    }

    static int64_t sinter_net_udp_send_to(int64_t fd, sinter_string host, int64_t port,
                                          sinter_string data) {
        if (sinter_net_ready() != 0) return -1;
        struct addrinfo hints, *res = NULL;
        memset(&hints, 0, sizeof(hints));
        hints.ai_family = AF_UNSPEC;
        hints.ai_socktype = SOCK_DGRAM;
        char portbuf[16];
        snprintf(portbuf, sizeof(portbuf), "%lld", (long long)port);
        if (getaddrinfo(sinter_string_to_cstr(host), portbuf, &hints, &res) != 0) return -1;
        int64_t sent = -1;
        for (struct addrinfo* ai = res; ai; ai = ai->ai_next) {
            sinter_net_ssize_t n = sendto((sinter_net_socket_t)fd, data.data, (int)data.len,
                                          MSG_NOSIGNAL, ai->ai_addr, (int)ai->ai_addrlen);
            if (n >= 0) { sent = (int64_t)n; break; }
        }
        freeaddrinfo(res);
        return sent;
    }

    static char sinter_net_peer_host[128];
    static int64_t sinter_net_peer_port;

    static sinter_string sinter_net_udp_recv_from(int64_t fd, int64_t max_bytes) {
        if (max_bytes <= 0) max_bytes = 4096;
        char* buf = (char*)malloc((size_t)max_bytes);
        if (!buf) return sinter_string_from_literal("", 0);
        struct sockaddr_storage ss;
        socklen_t slen = sizeof(ss);
        sinter_net_ssize_t n;
        do {
            n = recvfrom((sinter_net_socket_t)fd, buf, (int)max_bytes, 0,
                         (struct sockaddr*)&ss, &slen);
        } while (n < 0 && SINTER_NET_ERRNO == SINTER_NET_EINTR);
        sinter_net_peer_host[0] = '\0';
        sinter_net_peer_port = 0;
        if (n < 0) { free(buf); return sinter_string_from_literal("", 0); }
        if (ss.ss_family == AF_INET) {
            struct sockaddr_in* in4 = (struct sockaddr_in*)&ss;
            inet_ntop(AF_INET, &in4->sin_addr, sinter_net_peer_host,
                      sizeof(sinter_net_peer_host));
            sinter_net_peer_port = (int64_t)ntohs(in4->sin_port);
        } else if (ss.ss_family == AF_INET6) {
            struct sockaddr_in6* in6 = (struct sockaddr_in6*)&ss;
            inet_ntop(AF_INET6, &in6->sin6_addr, sinter_net_peer_host,
                      sizeof(sinter_net_peer_host));
            sinter_net_peer_port = (int64_t)ntohs(in6->sin6_port);
        }
        sinter_string out = sinter_string_from_buf(buf, (int64_t)n);
        free(buf);
        return out;
    }
}

/// Bind and listen. Returns a socket descriptor, or -1 on failure.
pub fun osTcpListen(host: str, port: i64, backlog: i64): i64 =>
    sinter_net_tcp_listen(host, port, backlog)
/// Connect to host:port (DNS names are resolved). Returns -1 on failure.
pub fun osTcpConnect(host: str, port: i64): i64 => sinter_net_tcp_connect(host, port)
/// Accept one connection (blocks). Returns -1 on failure.
pub fun osTcpAccept(server: i64): i64 => sinter_net_tcp_accept(server)
pub fun osTcpSend(fd: i64, text: str): i64 => sinter_net_send(fd, text)
pub fun osTcpRecv(fd: i64, maxBytes: i64): str => sinter_net_recv(fd, maxBytes)
pub fun osTcpRecvAll(fd: i64, maxBytes: i64): str => sinter_net_recv_all(fd, maxBytes)
pub fun osTcpRecvLine(fd: i64): str => sinter_net_recv_line(fd)
pub fun osTcpClose(fd: i64): void => sinter_net_close(fd)
pub fun osTcpShutdown(fd: i64): void => sinter_net_shutdown(fd)
pub fun osSocketTimeout(fd: i64, ms: i64): bool => sinter_net_set_timeout(fd, ms) != 0
pub fun osSocketLocalPort(fd: i64): i64 => sinter_net_local_port(fd)
pub fun osSocketLastError(): str => sinter_net_last_error()
pub fun osUdpBind(host: str, port: i64): i64 => sinter_net_udp_bind(host, port)
pub fun osUdpSendTo(fd: i64, host: str, port: i64, text: str): i64 =>
    sinter_net_udp_send_to(fd, host, port, text)
pub fun osUdpRecvFrom(fd: i64, maxBytes: i64): str => sinter_net_udp_recv_from(fd, maxBytes)
pub fun osUdpLastPeerHost(): str => sinter_string_from_cstr(sinter_net_peer_host)
pub fun osUdpLastPeerPort(): i64 => sinter_net_peer_port
