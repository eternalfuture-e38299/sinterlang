// sinter standard library: process environment
//
// Does only the two most common things with clear cross-platform semantics: read environment variables, exit the process.
// A missing environment variable returns Option, not an empty string (an empty string is a valid value too).
module std.env

import std
import std.string
import std.option

embed C {
    #include <stdlib.h>

    static inline sinter_string sinter_env_get(const char* name) {
        const char* v = getenv(name);
        if (!v) return sinter_string_from_literal("", 0);
        return sinter_string_from_cstr(v);
    }

    static inline void sinter_env_exit(int64_t code) {
        exit((int)code);
    }
}

// shortcut: C's getenv can't tell "missing" from "empty"; both return None;
// use getenv_s / platform-specific APIs when you need to distinguish them.
pub fun getenv(name: str): Option<str> {
    val value: str = sinter_env_get(name.toCStr())
    if value.length() == 0 && name.length() > 0 { ret noneStr() }
    ret someStr(value)
}

pub fun hasEnv(name: str): bool => getenv(name).isSome()

pub fun exit(code: i64): void => sinter_env_exit(code)
