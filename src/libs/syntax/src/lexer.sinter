// Sinter lexer used by the self-hosted compiler and language server.
module lexer

import std
import syntax

fun isDigit(c: i64): bool => c >= 48 && c <= 57
fun isHex(c: i64): bool => isDigit(c) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102)
fun isAlpha(c: i64): bool => (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
fun isAlnum(c: i64): bool => isAlpha(c) || isDigit(c)

pub class Lexer {
    var src: str
    var pos: i64
    var len: i64
    var line: i64
    var col: i64

    Lexer(input: str) {
        self.src = input
        self.pos = 0
        self.len = input.length()
        self.line = 1
        self.col = 1
    }

    fun at(i: i64): i64 {
        if i < 0 || i >= self.len { ret -1 }
        ret self.src.at(i)
    }

    fun startsWith(s: str): bool {
        if self.pos + s.length() > self.len { ret false }
        ret self.src.substring(self.pos, self.pos + s.length()) == s
    }

    fun advance(): i64 {
        if self.pos >= self.len { ret -1 }
        val c = self.src.at(self.pos)
        self.pos = self.pos + 1
        if c == 13 {
            if self.pos < self.len && self.src.at(self.pos) == 10 { self.pos = self.pos + 1 }
            self.line = self.line + 1
            self.col = 1
        } else if c == 10 {
            self.line = self.line + 1
            self.col = 1
        } else {
            self.col = self.col + 1
        }
        ret c
    }

    fun skipSpaces(): void {
        while self.pos < self.len {
            val c = self.src.at(self.pos)
            if c == 32 || c == 9 { self.advance() } else { ret }
        }
    }

    fun skipLineComment(): void {
        while self.pos < self.len {
            val c = self.src.at(self.pos)
            if c == 10 || c == 13 { ret }
            self.advance()
        }
    }

    fun skipBlockComment(out: Tokens, before: i64): void {
        self.advance()
        self.advance()
        while self.pos < self.len {
            if self.startsWith("*/") {
                self.advance()
                self.advance()
                if self.line != before { out.add(TokenKind.Newline, "\n", before, 1) }
                ret
            }
            self.advance()
        }
    }

    fun escapeTriple(s: str): str {
        var out = ""
        var i: i64 = 0
        while i < s.length() {
            if s.at(i) == 92 { out = out + "\\\\" } else { out = out + s.substring(i, i + 1) }
            i = i + 1
        }
        ret out
    }

    fun readString(quote: i64, triple: bool): str {
        self.advance()
        if triple {
            self.advance()
            self.advance()
        }
        val start = self.pos
        if triple {
            while self.pos < self.len {
                var close = false
                if quote == 34 {
                    if self.at(self.pos) == 34 && self.at(self.pos + 1) == 34 && self.at(self.pos + 2) == 34 { close = true }
                } else {
                    if self.at(self.pos) == 39 && self.at(self.pos + 1) == 39 && self.at(self.pos + 2) == 39 { close = true }
                }
                if close { break }
                self.advance()
            }
            val text = self.src.substring(start, self.pos)
            if self.pos < self.len { self.advance(); self.advance(); self.advance() }
            ret self.escapeTriple(text)
        }
        while self.pos < self.len {
            val c = self.src.at(self.pos)
            if c == quote { break }
            if c == 92 {
                self.advance()
                if self.pos < self.len { self.advance() }
            } else if c == 36 && self.pos + 1 < self.len && self.src.at(self.pos + 1) == 123 {
                self.advance()
                self.advance()
                var depth: i64 = 1
                while self.pos < self.len && depth > 0 {
                    val d = self.src.at(self.pos)
                    if d == 34 || d == 39 {
                        val q = d
                        self.advance()
                        while self.pos < self.len {
                            val e = self.src.at(self.pos)
                            if e == 92 { self.advance(); if self.pos < self.len { self.advance() } }
                            else if e == q { self.advance(); break }
                            else { self.advance() }
                        }
                    } else if d == 123 { depth = depth + 1; self.advance() }
                    else if d == 125 { depth = depth - 1; self.advance() }
                    else { self.advance() }
                }
            } else {
                self.advance()
            }
        }
        val text = self.src.substring(start, self.pos)
        if self.pos < self.len && self.src.at(self.pos) == quote { self.advance() }
        ret text
    }

    fun scanEmbed(start: i64): bool {
        val savePos = self.pos
        val saveLine = self.line
        val saveCol = self.col
        self.skipSpaces()
        if self.at(self.pos) != 67 {
            self.pos = savePos
            self.line = saveLine
            self.col = saveCol
            ret false
        }
        self.advance()
        self.skipSpaces()
        if self.startsWith("header") {
            while self.pos < self.len && self.src.at(self.pos) != 10 && self.src.at(self.pos) != 13 && self.src.at(self.pos) != 123 { self.advance() }
            self.skipSpaces()
        }
        if self.at(self.pos) != 123 {
            self.pos = savePos
            self.line = saveLine
            self.col = saveCol
            ret false
        }
        var depth: i64 = 1
        self.advance()
        while self.pos < self.len {
            val c = self.src.at(self.pos)
            if c == 34 || c == 39 {
                val q = c
                self.advance()
                while self.pos < self.len {
                    val d = self.src.at(self.pos)
                    if d == 92 {
                        self.advance()
                        if self.pos < self.len { self.advance() }
                    } else if d == q {
                        self.advance()
                        break
                    } else {
                        self.advance()
                    }
                }
            } else if c == 47 && self.at(self.pos + 1) == 47 {
                self.skipLineComment()
            } else if c == 47 && self.at(self.pos + 1) == 42 {
                self.advance()
                self.advance()
                while self.pos < self.len && !self.startsWith("*/") { self.advance() }
                if self.pos < self.len { self.advance(); self.advance() }
            } else if c == 123 {
                depth = depth + 1
                self.advance()
            } else if c == 125 {
                depth = depth - 1
                self.advance()
                if depth == 0 { ret true }
            } else {
                self.advance()
            }
        }
        ret true
    }

    fun readIdent(out: Tokens): void {
        val start = self.pos
        val ln = self.line
        val cl = self.col
        while self.pos < self.len && isAlnum(self.src.at(self.pos)) { self.advance() }
        val text = self.src.substring(start, self.pos)
        if text == "embed" {
            if self.scanEmbed(start) {
                out.add(TokenKind.Embed, self.src.substring(start, self.pos), ln, cl)
                ret
            }
        }
        out.add(TokenKind.Ident, text, ln, cl)
    }

    fun readNumber(out: Tokens): void {
        val start = self.pos
        val ln = self.line
        val cl = self.col
        if self.at(self.pos) == 48 && (self.at(self.pos + 1) == 120 || self.at(self.pos + 1) == 88) {
            self.advance()
            self.advance()
            while self.pos < self.len && (isHex(self.src.at(self.pos)) || self.src.at(self.pos) == 95) { self.advance() }
        } else if self.at(self.pos) == 48 && (self.at(self.pos + 1) == 98 || self.at(self.pos + 1) == 66) {
            self.advance()
            self.advance()
            while self.pos < self.len && (self.src.at(self.pos) == 48 || self.src.at(self.pos) == 49 || self.src.at(self.pos) == 95) { self.advance() }
        } else if self.at(self.pos) == 48 && (self.at(self.pos + 1) == 111 || self.at(self.pos + 1) == 79) {
            self.advance()
            self.advance()
            while self.pos < self.len {
                val c = self.src.at(self.pos)
                if ((c >= 48 && c <= 55) || c == 95) { self.advance() } else { break }
            }
        } else {
            var fl = false
            while self.pos < self.len {
                val c = self.src.at(self.pos)
                if isDigit(c) || c == 95 { self.advance(); continue }
                if c == 46 && !fl {
                    if self.at(self.pos + 1) == 46 { break }
                    if !isDigit(self.at(self.pos + 1)) { break }
                    fl = true
                    self.advance()
                    continue
                }
                if ((c == 101 || c == 69) && (isDigit(self.at(self.pos + 1)) || ((self.at(self.pos + 1) == 43 || self.at(self.pos + 1) == 45) && isDigit(self.at(self.pos + 2))))) {
                    fl = true
                    self.advance()
                    if self.at(self.pos) == 43 || self.at(self.pos) == 45 { self.advance() }
                    continue
                }
                break
            }
            while self.pos < self.len && isAlnum(self.src.at(self.pos)) { self.advance() }
            val text = self.src.substring(start, self.pos)
            if fl { out.add(TokenKind.Float, text, ln, cl) } else { out.add(TokenKind.Integer, text, ln, cl) }
            ret
        }
        while self.pos < self.len && isAlnum(self.src.at(self.pos)) { self.advance() }
        out.add(TokenKind.Integer, self.src.substring(start, self.pos), ln, cl)
    }

    fun readPunct(out: Tokens, diags: Diagnostics): void {
        val ln = self.line
        val cl = self.col
        if self.startsWith("<<=") { out.add(TokenKind.Punct, "<<=", ln, cl); self.advance(); self.advance(); self.advance(); ret }
        if self.startsWith(">>=") { out.add(TokenKind.Punct, ">>=", ln, cl); self.advance(); self.advance(); self.advance(); ret }
        if self.startsWith("===") { out.add(TokenKind.Punct, "===", ln, cl); self.advance(); self.advance(); self.advance(); ret }
        if self.startsWith("!==") { out.add(TokenKind.Punct, "!==", ln, cl); self.advance(); self.advance(); self.advance(); ret }
        if self.startsWith("->") { out.add(TokenKind.Punct, "->", ln, cl); self.advance(); self.advance(); ret }
        if self.startsWith("=>") { out.add(TokenKind.Punct, "=>", ln, cl); self.advance(); self.advance(); ret }
        if self.startsWith("==") { out.add(TokenKind.Punct, "==", ln, cl); self.advance(); self.advance(); ret }
        if self.startsWith("!=") { out.add(TokenKind.Punct, "!=", ln, cl); self.advance(); self.advance(); ret }
        if self.startsWith("<=") { out.add(TokenKind.Punct, "<=", ln, cl); self.advance(); self.advance(); ret }
        if self.startsWith(">=") { out.add(TokenKind.Punct, ">=", ln, cl); self.advance(); self.advance(); ret }
        if self.startsWith("&&") { out.add(TokenKind.Punct, "&&", ln, cl); self.advance(); self.advance(); ret }
        if self.startsWith("||") { out.add(TokenKind.Punct, "||", ln, cl); self.advance(); self.advance(); ret }
        if self.startsWith("<<") { out.add(TokenKind.Punct, "<<", ln, cl); self.advance(); self.advance(); ret }
        if self.startsWith(">>") { out.add(TokenKind.Punct, ">>", ln, cl); self.advance(); self.advance(); ret }
        if self.startsWith("+=") { out.add(TokenKind.Punct, "+=", ln, cl); self.advance(); self.advance(); ret }
        if self.startsWith("-=") { out.add(TokenKind.Punct, "-=", ln, cl); self.advance(); self.advance(); ret }
        if self.startsWith("*=") { out.add(TokenKind.Punct, "*=", ln, cl); self.advance(); self.advance(); ret }
        if self.startsWith("/=") { out.add(TokenKind.Punct, "/=", ln, cl); self.advance(); self.advance(); ret }
        if self.startsWith("%=") { out.add(TokenKind.Punct, "%=", ln, cl); self.advance(); self.advance(); ret }
        if self.startsWith("&=") { out.add(TokenKind.Punct, "&=", ln, cl); self.advance(); self.advance(); ret }
        if self.startsWith("|=") { out.add(TokenKind.Punct, "|=", ln, cl); self.advance(); self.advance(); ret }
        if self.startsWith("^=") { out.add(TokenKind.Punct, "^=", ln, cl); self.advance(); self.advance(); ret }
        if self.startsWith("!!") { out.add(TokenKind.Punct, "!!", ln, cl); self.advance(); self.advance(); ret }
        if self.startsWith("++") { out.add(TokenKind.Punct, "++", ln, cl); self.advance(); self.advance(); ret }
        if self.startsWith("--") { out.add(TokenKind.Punct, "--", ln, cl); self.advance(); self.advance(); ret }
        if self.startsWith("::") { out.add(TokenKind.Punct, "::", ln, cl); self.advance(); self.advance(); ret }
        if self.startsWith("...") { out.add(TokenKind.Punct, "...", ln, cl); self.advance(); self.advance(); self.advance(); ret }
        if self.startsWith("..") { out.add(TokenKind.Punct, "..", ln, cl); self.advance(); self.advance(); ret }
        if self.startsWith("?.") { out.add(TokenKind.Punct, "?.", ln, cl); self.advance(); self.advance(); ret }
        val c = self.src.at(self.pos)
        if c == 40 || c == 41 || c == 123 || c == 125 || c == 91 || c == 93 || c == 44 || c == 59 || c == 58 || c == 46 || c == 60 || c == 62 || c == 43 || c == 45 || c == 42 || c == 47 || c == 37 || c == 38 || c == 124 || c == 94 || c == 33 || c == 126 || c == 61 || c == 63 || c == 64 || c == 35 || c == 36 {
            out.add(TokenKind.Punct, self.src.substring(self.pos, self.pos + 1), ln, cl)
            self.advance()
            ret
        }
        out.add(TokenKind.Punct, self.src.substring(self.pos, self.pos + 1), ln, cl)
        diags.add(ln, cl, "unexpected character '" + self.src.substring(self.pos, self.pos + 1) + "'")
        self.advance()
    }

    pub fun tokenize(out: Tokens, diags: Diagnostics): void {
        while self.pos < self.len {
            val c = self.src.at(self.pos)
            if c == 32 || c == 9 { self.advance(); continue }
            if c == 10 || c == 13 {
                val ln = self.line
                val cl = self.col
                self.advance()
                out.add(TokenKind.Newline, "\n", ln, cl)
                continue
            }
            if c == 47 && self.at(self.pos + 1) == 47 { self.skipLineComment(); continue }
            if c == 47 && self.at(self.pos + 1) == 42 {
                val before = self.line
                self.skipBlockComment(out, before)
                continue
            }
            if c == 34 {
                val ln = self.line
                val cl = self.col
                val triple = self.at(self.pos) == 34 && self.at(self.pos + 1) == 34 && self.at(self.pos + 2) == 34
                val text = self.readString(34, triple)
                out.add(TokenKind.String, text, ln, cl)
                continue
            }
            if c == 39 {
                val ln = self.line
                val cl = self.col
                val triple = self.at(self.pos) == 39 && self.at(self.pos + 1) == 39 && self.at(self.pos + 2) == 39
                val text = self.readString(39, triple)
                out.add(TokenKind.Char, text, ln, cl)
                continue
            }
            if isDigit(c) { self.readNumber(out); continue }
            if isAlpha(c) { self.readIdent(out); continue }
            self.readPunct(out, diags)
        }
        out.add(TokenKind.Eof, "", self.line, self.col)
    }
}
