// Conservative C formatter used by `sinterd reindent`.  It keeps the author's
// line breaks and only normalizes indentation plus a small set of token spaces.
module cformat

import std
import std.string
import cfront

fun isControlWord(w: str): bool {
    if w == "if" || w == "while" || w == "for" || w == "switch" { ret true }
    if w == "return" || w == "sizeof" || w == "alignof" || w == "do" || w == "else" { ret true }
    ret false
}

fun noSpaceBefore(w: str): bool {
    if w == ")" || w == "]" || w == ";" || w == "," { ret true }
    if w == "." || w == "->" || w == "++" || w == "--" || w == "[" { ret true }
    ret false
}

fun noSpaceAfter(w: str): bool {
    if w == "(" || w == "[" || w == "." || w == "->" || w == "!" || w == "~" { ret true }
    ret false
}

fun indentText(level: i64, width: i64, tabs: bool): str {
    var lv = level
    if lv < 0 { lv = 0 }
    var out = ""
    if tabs {
        var i: i64 = 0
        while i < lv { out = out + "\t"; i = i + 1 }
        ret out
    }
    var n = lv * width
    var i: i64 = 0
    while i < n { out = out + " "; i = i + 1 }
    ret out
}

class Formatter {
    var out: str
    var line: str
    var indent: i64
    var base: i64
    var width: i64
    var tabs: bool

    Formatter(baseIndent: i64, indentWidth: i64, useTabs: bool) {
        self.out = ""
        self.line = ""
        self.indent = baseIndent
        self.base = baseIndent
        self.width = indentWidth
        self.tabs = useTabs
    }

    fun begin(): void {
        if self.line.length() == 0 {
            self.line = indentText(self.indent, self.width, self.tabs)
        }
    }

    fun space(): void {
        if self.line.length() == 0 { ret }
        val c = self.line.at(self.line.length() - 1)
        if c != 32 && c != 9 { self.line = self.line + " " }
    }

    fun flush(): void {
        var b = self.line.length()
        while b > 0 {
            val c = self.line.at(b - 1)
            if c == 32 || c == 9 { b = b - 1 } else { break }
        }
        if b > 0 {
            self.out = self.out + self.line.substring(0, b)
            self.out = self.out + "\n"
        }
        self.line = ""
    }

    fun appendText(t: str): void {
        self.begin()
        self.line = self.line + t
    }

    fun needSpace(toks: CTokens, prevIdx: i64, cur: str): bool {
        if prevIdx < 0 { ret false }
        val prev = toks.text(prevIdx)
        if prev.length() == 0 { ret false }
        if noSpaceBefore(cur) { ret false }
        if noSpaceAfter(prev) { ret false }
        if cur == "(" && !isControlWord(prev) { ret false }
        ret true
    }

    fun run(toks: CTokens): str {
        var prevIdx: i64 = -1
        var i: i64 = 0
        while i < toks.size() {
            val k = toks.kind(i)
            if k == CTokKind.Eof { break }
            val tx = toks.text(i)
            if k == CTokKind.Preproc {
                self.flush()
                self.line = tx + ""
                self.flush()
                prevIdx = -1
                i = i + 1
                continue
            }
            if toks.lead(i) { self.flush() }
            if k == CTokKind.Comment {
                if tx.startsWith("//") {
                    self.flush()
                    self.line = indentText(self.indent, self.width, self.tabs) + tx
                    self.flush()
                } else {
                    if self.line.length() > 0 { self.space() }
                    self.appendText(tx)
                }
                prevIdx = i
                i = i + 1
                continue
            }
            if tx == "}" {
                if self.indent > self.base { self.indent = self.indent - 1 }
                self.flush()
                self.appendText("}")
                prevIdx = i
                i = i + 1
                continue
            }
            if tx == "{" {
                if self.line.length() > 0 { self.space() }
                self.appendText("{")
                self.indent = self.indent + 1
                prevIdx = i
                i = i + 1
                continue
            }
            if self.line.length() > 0 && self.needSpace(toks, prevIdx, tx) { self.space() }
            self.appendText(tx)
            prevIdx = i
            i = i + 1
        }
        self.flush()
        ret self.out
    }
}

pub fun reindentC(src: str, baseIndent: i64, indentWidth: i64, useTabs: bool): str {
    val toks = lexC(src)
    if toks.size() == 0 { ret src }
    val f = Formatter(baseIndent, indentWidth, useTabs)
    ret f.run(toks)
}
