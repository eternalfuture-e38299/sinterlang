module runtime_text

pub fun runtimeHeader(): str => """/* sinter runtime support - generated by sinterc, do not edit */
#ifndef SINTER_RUNTIME_H
#define SINTER_RUNTIME_H
/* POSIX feature-test macros must precede every system header. */
#ifndef _POSIX_C_SOURCE
#define _POSIX_C_SOURCE 200809L
#endif
#ifndef _DEFAULT_SOURCE
#define _DEFAULT_SOURCE 1
#endif

/* No system headers are included: fixed-width types come from compiler
   builtins so they are identical to the target libc's int64_t/uint64_t. */
#ifndef SINTER_BASIC_TYPES
#define SINTER_BASIC_TYPES
typedef signed char        int8_t;
typedef __INT16_TYPE__     int16_t;
typedef __INT32_TYPE__     int32_t;
typedef __INT64_TYPE__     int64_t;
typedef unsigned char      uint8_t;
typedef __UINT16_TYPE__    uint16_t;
typedef __UINT32_TYPE__    uint32_t;
typedef __UINT64_TYPE__    uint64_t;
typedef __SIZE_TYPE__      size_t;
#endif

#ifndef NULL
#define NULL ((void*)0)
#endif

/* Portable unused marker. */
#ifndef sinter_maybe_unused
#if defined(__GNUC__) || defined(__clang__)
#define sinter_maybe_unused __attribute__((unused))
#else
#define sinter_maybe_unused
#endif
#endif

/* libc declarations (C11 signatures, no system headers). */
#ifndef SINTER_LIBC_DECLS
#define SINTER_LIBC_DECLS
typedef size_t sinter_size_t;
void* malloc(sinter_size_t);
void* calloc(sinter_size_t, sinter_size_t);
void* realloc(void*, sinter_size_t);
void  free(void*);
void* memcpy(void*, const void*, sinter_size_t);
void* memmove(void*, const void*, sinter_size_t);
void* memset(void*, int, sinter_size_t);
int   memcmp(const void*, const void*, sinter_size_t);
sinter_size_t strlen(const char*);
int   strcmp(const char*, const char*);
int   puts(const char*);
int   putchar(int);
void  exit(int);
void  abort(void);
double sqrt(double);
double pow(double, double);
double fabs(double);
double floor(double);
double ceil(double);
#endif

/* Virtual dispatch. Every vtable slot has the same function-pointer type `sinter_vfn`:
   call sites are written as `((T(*)(...))obj->__vptr[i])(args)`, which is a
   function-pointer-to-function-pointer conversion; ISO C 6.3.2.3 allows it,
   so `-std=c99 -pedantic-errors` no longer reports "ISO C forbids conversion of
   object pointer to function pointer type". */
#ifndef SINTER_VSLOT_DECLS
#define SINTER_VSLOT_DECLS
typedef void (*sinter_vfn)(void);
#endif

#ifdef __cplusplus
extern "C" {
#endif

/* ---- internal string ---------------------------------------------------- */
typedef struct sinter_string {
    char*   data;
    int64_t len;
    int64_t cap;
    /* owned=1: data is heap memory and is freed on destruction.
       owned=0: data points into the static literal pool, nothing to free. */
    int32_t owned;
} sinter_string;

sinter_string sinter_string_from_literal(const char* s, int64_t len);
sinter_string sinter_string_from_cstr(const char* s);
sinter_string sinter_string_from_buf(const char* buf, int64_t len);
sinter_string sinter_string_clone(sinter_string s);
sinter_string sinter_string_from_int(int64_t v);
sinter_string sinter_string_from_num(double v);
sinter_string sinter_string_from_bool(uint8_t v);
sinter_string sinter_string_concat(sinter_string a, sinter_string b);
int32_t sinter_string_compare(sinter_string a, sinter_string b);
uint8_t sinter_string_equals(sinter_string a, sinter_string b);
const char* sinter_string_to_cstr(sinter_string s);
void sinter_string_free(sinter_string s);

/* ---- exceptions + diagnostics ---- */
#include <setjmp.h>
#if defined(_MSC_VER)
#define SINTER_TLS __declspec(thread)
#else
#define SINTER_TLS __thread
#endif
typedef struct sinter_exc_frame { jmp_buf buf; struct sinter_exc_frame* prev; int cleanup_top; } sinter_exc_frame;
extern SINTER_TLS sinter_exc_frame* sinter_exc_top;
extern SINTER_TLS sinter_string sinter_exc_value;
extern SINTER_TLS char sinter_exc_where[320];
void sinter_throw(sinter_string msg, const char* file, int line);
sinter_string sinter_exc_take(void);
void sinter_backtrace(void);

typedef void (*sinter_cleanup_fn)(void*);
void sinter_cleanup_push(void* p, sinter_cleanup_fn fn);
void sinter_cleanup_pop(int n);
void sinter_cleanup_run_to(int mark);
int sinter_cleanup_mark(void);
int sinter_cleanup_depth(void);
void sinter_cleanup_reset(void);
void sinter_cleanup_string(void* p);
void sinter_string_assign(sinter_string* dst, sinter_string src);
sinter_string sinter_string_concat_take_left(sinter_string a, sinter_string b);
sinter_string sinter_string_concat_take_right(sinter_string a, sinter_string b);
sinter_string sinter_string_concat_own(sinter_string a, sinter_string b);

/* Compile-time literal initializer (the malloc version is runtime only). */
#define sinter_string_static(lit, n) { (char*)(lit), (int64_t)(n), (int64_t)(n), 0 }

const char* sinter_int_to_str(int64_t v);
const char* sinter_num_to_str(double v);

/* String concatenation (returns heap memory). */
const char* sinter_str_concat(const char* a, const char* b);

/* Runtime type test: chain looks like {"Dog", "Animal", 0}. */
uint8_t sinter_type_is(const char* const* chain, const char* want);

#ifdef __cplusplus
}
#endif

#endif /* SINTER_RUNTIME_H */

"""

pub fun runtimeSource(): str => """/* Sinter runtime support library - generated by sinterc, do not edit */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#ifdef _WIN32
#include <windows.h>
#elif !defined(__ANDROID__)
#include <execinfo.h>
#endif

/* ---- sinter_string implementation ---- */
static sinter_string sinter_string_alloc(int64_t cap) {
    sinter_string s;
    s.len = 0;
    s.cap = cap < 8 ? 8 : cap;
    s.data = (char*)malloc((size_t)s.cap + 1);
    s.owned = 1;
    if (!s.data) { s.cap = 0; s.owned = 0; return s; }
    s.data[0] = 0;
    return s;
}

/* Compile-time literals: no copy, point straight at bytes in .rodata (owned=0).
   This avoids a malloc per evaluation and lets the destructor skip them safely. */
sinter_string sinter_string_from_literal(const char* src, int64_t len) {
    sinter_string s;
    if (len < 0) len = 0;
    if (len > 0 && !src) len = 0;
    s.data = (char*)(len > 0 ? src : "");
    s.len = len;
    s.cap = len;
    s.owned = 0;
    return s;
}

/* When an owned copy is required (e.g. building from a C buffer), copy to the heap. */
static sinter_string sinter_string_copy_from(const char* src, int64_t len) {
    if (len < 0) len = 0;
    if (len > 0 && !src) len = 0;
    sinter_string s = sinter_string_alloc(len);
    if (!s.data) { s.len = 0; return s; }
    if (len > 0) memcpy(s.data, src, (size_t)len);
    s.data[len] = 0;
    s.len = len;
    return s;
}

sinter_string sinter_string_from_cstr(const char* src) {
    if (!src) return sinter_string_alloc(0);
    return sinter_string_copy_from(src, (int64_t)strlen(src));
}

sinter_string sinter_string_clone(sinter_string s) {
    return sinter_string_copy_from(s.data, s.len);
}

sinter_string sinter_string_from_buf(const char* buf, int64_t n) {
    if (n < 0) return sinter_string_alloc(0);
    return sinter_string_copy_from(buf, (int64_t)n);
}

sinter_string sinter_string_from_int(int64_t v) {
    /* Decimal conversion is done by hand so the runtime only needs <stdio.h>
       for one float-formatting call site. INT64_MIN would overflow on negation,
       so accumulate through an unsigned value. */
    char buf[24];
    int n = 0;
    uint64_t u = v < 0 ? (uint64_t)(-(v + 1)) + 1u : (uint64_t)v;
    if (v < 0) buf[n++] = '-';
    char tmp[20];
    int m = 0;
    do { tmp[m++] = (char)('0' + (int)(u % 10u)); u /= 10u; } while (u);
    while (m > 0) buf[n++] = tmp[--m];
    return sinter_string_from_buf(buf, n);
}

sinter_string sinter_string_from_num(double v) {
    /* Full %g semantics (precision, exponent switching, round-trip consistency)
       are not worth reimplementing by hand, so the runtime keeps one snprintf here.
       Generated user code does not need <stdio.h>. */
    char buf[64];
    return sinter_string_from_buf(buf, snprintf(buf, sizeof(buf), "%g", v));
}

sinter_string sinter_string_from_bool(uint8_t v) {
    return sinter_string_from_cstr(v ? "true" : "false");
}

sinter_string sinter_string_concat(sinter_string a, sinter_string b) {
    const int64_t need = a.len + b.len;
    sinter_string s = sinter_string_alloc(need);
    if (!s.data) { s.len = 0; return s; }
    if (a.len > 0 && a.data) memcpy(s.data, a.data, (size_t)a.len);
    if (b.len > 0 && b.data) memcpy(s.data + a.len, b.data, (size_t)b.len);
    s.data[need] = 0;
    s.len = need;
    return s;
}

sinter_string sinter_string_concat_take_right(sinter_string a, sinter_string b) {
    sinter_string s = sinter_string_concat(a, b);
    /* The right operand is a temporary and nobody needs it after concatenation,
       so its buffer is released here. The left operand is never touched: the
       caller may still be using it. */
    if (b.owned && b.data) free(b.data);
    return s;
}

sinter_string sinter_string_concat_take_left(sinter_string a, sinter_string b) {
    sinter_string s = sinter_string_concat(a, b);
    if (a.owned && a.data) free(a.data);
    return s;
}

sinter_string sinter_string_concat_own(sinter_string a, sinter_string b) {
    sinter_string s = sinter_string_concat(a, b);
    if (a.owned && a.data) free(a.data);
    if (b.owned && b.data) free(b.data);
    return s;
}

int32_t sinter_string_compare(sinter_string a, sinter_string b) {
    const int64_t n = a.len < b.len ? a.len : b.len;
    if (n > 0 && a.data && b.data) {
        const int r = memcmp(a.data, b.data, (size_t)n);
        if (r) return r < 0 ? -1 : 1;
    }
    if (a.len == b.len) return 0;
    return a.len < b.len ? -1 : 1;
}

uint8_t sinter_string_equals(sinter_string a, sinter_string b) {
    return (uint8_t)(sinter_string_compare(a, b) == 0);
}

const char* sinter_string_to_cstr(sinter_string s) {
    return s.data ? s.data : "";
}

void sinter_string_free(sinter_string s) {
    /* Only heap-allocated buffers are freed; static literals (owned=0) are left alone.
       Freeing an owned=0 literal buffer would crash. */
    if (s.owned && s.data) free(s.data);
}

void sinter_string_assign(sinter_string* dst, sinter_string src) {
    if (!dst) return;
    sinter_string_free(*dst);
    *dst = src;
}

const char* sinter_int_to_str(int64_t v) {
    char buf[32];
    int n = snprintf(buf, sizeof(buf), "%lld", (long long)v);
    if (n < 0) return NULL;
    char* out = (char*)malloc((size_t)n + 1);
    if (!out) return NULL;
    memcpy(out, buf, (size_t)n + 1);
    return out;
}

const char* sinter_num_to_str(double v) {
    char buf[64];
    int n = snprintf(buf, sizeof(buf), "%g", v);
    if (n < 0) return NULL;
    char* out = (char*)malloc((size_t)n + 1);
    if (!out) return NULL;
    memcpy(out, buf, (size_t)n + 1);
    return out;
}

const char* sinter_str_concat(const char* a, const char* b) {
    if (!a) a = "";
    if (!b) b = "";
    size_t la = strlen(a), lb = strlen(b);
    char* out = (char*)malloc(la + lb + 1);
    if (!out) return NULL;
    memcpy(out, a, la);
    memcpy(out + la, b, lb + 1);
    return out;
}

uint8_t sinter_type_is(const char* const* chain, const char* want) {
    if (!chain || !want) return 0;
    for (int i = 0; chain[i]; ++i) {
        const char* a = chain[i];
        const char* b = want;
        while (*a && *b && *a == *b) { ++a; ++b; }
        if (*a == 0 && *b == 0) return 1;
    }
    return 0;
}

/* ---- exceptions ---- */
SINTER_TLS sinter_exc_frame* sinter_exc_top = NULL;
SINTER_TLS sinter_string sinter_exc_value;
SINTER_TLS char sinter_exc_where[320];

void sinter_backtrace(void) {
#ifdef _WIN32
    void* frames[32];
    USHORT n = RtlCaptureStackBackTrace(0, 32, frames, NULL);
    for (USHORT i = 0; i < n; ++i) fprintf(stderr, "  #%u %p\n", (unsigned)i, frames[i]);
#elif defined(__ANDROID__)
    fprintf(stderr, "  (backtrace unavailable on Android)\n");
#else
    void* frames[32];
    int n = backtrace(frames, 32);
    backtrace_symbols_fd(frames, n, 2);
#endif
}

/* ---- exception cleanup stack (RAII across longjmp) ---- */
SINTER_TLS void** sinter_cleanup_ptrs = NULL;
SINTER_TLS sinter_cleanup_fn* sinter_cleanup_fns = NULL;
SINTER_TLS int sinter_cleanup_n = 0;
SINTER_TLS int sinter_cleanup_cap = 0;

int sinter_cleanup_mark(void) { return sinter_cleanup_n; }
int sinter_cleanup_depth(void) { return sinter_cleanup_n; }
void sinter_cleanup_reset(void) { sinter_cleanup_n = 0; }
void sinter_cleanup_push(void* p, sinter_cleanup_fn fn) {
    if (!fn) return;
    if (sinter_cleanup_n >= sinter_cleanup_cap) {
        int nc = sinter_cleanup_cap ? sinter_cleanup_cap * 2 : 256;
        void** np = (void**)realloc(sinter_cleanup_ptrs, sizeof(void*) * (size_t)nc);
        sinter_cleanup_fn* nf = (sinter_cleanup_fn*)realloc(sinter_cleanup_fns, sizeof(sinter_cleanup_fn) * (size_t)nc);
        if (!np || !nf) abort();
        sinter_cleanup_ptrs = np;
        sinter_cleanup_fns = nf;
        sinter_cleanup_cap = nc;
    }
    sinter_cleanup_ptrs[sinter_cleanup_n] = p;
    sinter_cleanup_fns[sinter_cleanup_n] = fn;
    sinter_cleanup_n++;
}
void sinter_cleanup_pop(int n) {
    if (n <= 0) return;
    if (n > sinter_cleanup_n) n = sinter_cleanup_n;
    sinter_cleanup_n -= n;
}
void sinter_cleanup_run_to(int mark) {
    if (mark < 0) mark = 0;
    while (sinter_cleanup_n > mark) {
        sinter_cleanup_n--;
        sinter_cleanup_fns[sinter_cleanup_n](sinter_cleanup_ptrs[sinter_cleanup_n]);
    }
}
void sinter_cleanup_string(void* p) {
    sinter_string* s = (sinter_string*)p;
    sinter_string_free(*s);
    s->data = 0; s->len = 0; s->cap = 0; s->owned = 0;
}

void sinter_throw(sinter_string msg, const char* file, int line) {
    sinter_string prev = sinter_exc_value;
    sinter_exc_value = sinter_string_clone(msg);
    if (prev.owned) sinter_string_free(prev);
    snprintf(sinter_exc_where, sizeof(sinter_exc_where), "%s:%d", file ? file : "?", line);
    if (!sinter_exc_top) {
        sinter_cleanup_run_to(0);
        fputs("uncaught exception: ", stderr);
        if (sinter_exc_value.data) fwrite(sinter_exc_value.data, 1, (size_t)sinter_exc_value.len, stderr);
        fprintf(stderr, " (at %s)\n", sinter_exc_where);
        sinter_backtrace();
        fflush(stderr);
        abort();
    }
    sinter_cleanup_run_to(sinter_exc_top->cleanup_top);
    longjmp(sinter_exc_top->buf, 1);
}

sinter_string sinter_exc_take(void) {
    sinter_string v = sinter_exc_value;
    sinter_exc_value = sinter_string_from_literal("", 0);
    return v;
}
"""
