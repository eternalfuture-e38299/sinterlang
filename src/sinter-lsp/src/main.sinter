// Self-hosted LSP entry point.
module main

import std
import lsp
import sver

fun main(argc: i32, argv: **u8): i32 {
    if argc > 1 {
        val a = fromCStr(argv[1])
        if a == "--version" || a == "-V" { writeLine("sinter-lsp " + sver.text()); ret 0 }
    }
    Server().run()
    ret 0
}
