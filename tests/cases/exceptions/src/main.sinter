module exceptions
import std

fun check(n: i64): str {
    if n < 0 { throw "negative: ${n}" }
    ret "ok"
}

fun main(): void {
    try {
        println(check(1))
        println(check(-2))
    } catch (e: str) {
        println("caught " + e)
    } finally {
        println("finally")
    }
    try {
        throw "second"
    } catch {
        println("anonymous catch")
    }
    println("done")
}
