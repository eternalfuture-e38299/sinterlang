module tomllib
import std
import toml

fun main(): void {
    val doc = Toml()
    println(doc.parse(readText("data.toml")))
    val r = doc.root()
    println(doc.getString(r, "title", ""))
    println(doc.getBool(r, "enabled", false))
    println(doc.getInt(r, "count", 0))
    println(doc.getFloat(r, "ratio", 0.0))
    println(doc.getInt(r, "hex", 0))
    println(doc.getInt(r, "bin", 0))

    val od = doc.get(r, "offset_dt")
    println(doc.isOffsetDateTime(od))
    println(doc.dateYear(od))
    println(doc.dateMonth(od))
    println(doc.dateDay(od))
    println(doc.dateHour(od))
    println(doc.dateMinute(od))
    println(doc.dateSecond(od))
    println(doc.dateNanosecond(od))
    println(doc.dateOffsetMinutes(od))
    println(doc.asDateText(od))

    val ldt = doc.get(r, "local_dt")
    println(doc.isLocalDateTime(ldt))
    println(doc.dateNanosecond(ldt))
    val ld = doc.get(r, "local_date")
    println(doc.isLocalDate(ld))
    println(doc.dateDay(ld))
    val lt = doc.get(r, "local_time")
    println(doc.isLocalTime(lt))
    println(doc.dateNanosecond(lt))

    val tags = doc.get(r, "tags")
    println(doc.size(tags))
    println(doc.arrayMultiline(tags))
    println(doc.trailingComment(doc.indexAt(tags, 0)))
    println(doc.leadingTrivia(doc.indexAt(tags, 1)).contains("# second"))
    println(doc.leadingTrivia(doc.get(r, "title")) == "# file header\n")
    println(doc.trailingComment(doc.get(r, "title")))
    println(doc.documentTail().contains("# file tail"))

    val srv = doc.get(r, "server")
    println(doc.getString(srv, "host", ""))
    println(doc.getInt(srv, "port", 0))
    println(doc.getBool(doc.get(srv, "tls"), "enabled", true))
    val products = doc.get(r, "products")
    println(doc.size(products))
    println(doc.getString(doc.indexAt(products, 0), "name", ""))
    println(doc.getString(doc.indexAt(products, 1), "name", ""))
    println(doc.getFloat(doc.get(doc.indexAt(products, 1), "details"), "weight", 0.0))

    val ser = doc.serialize()
    val rt = Toml()
    println(rt.parse(ser))
    println(rt.serialize() == ser)
    println(rt.getInt(rt.get(rt.root(), "server"), "port", 0))
    println(rt.dateOffsetMinutes(rt.get(rt.root(), "offset_dt")))
    println(rt.size(rt.get(rt.root(), "products")))
    println(rt.getFloat(rt.get(rt.indexAt(rt.get(rt.root(), "products"), 1), "details"), "weight", 0.0))

    val built = Toml()
    val br = built.root()
    val nameNode = built.putString(br, "name", "built")
    built.setLeadingTrivia(nameNode, "# generated\n")
    built.setTrailingComment(nameNode, "# note")
    built.put(br, "d", built.localDate(2024, 2, 29))
    built.put(br, "t", built.localTime(12, 34, 56, 500000000))
    built.setDocumentTail("# end\n")
    println(built.serialize())
    val br2 = Toml()
    println(br2.parse(built.serialize()))
    println(br2.dateDay(br2.get(br2.root(), "d")))

    val bad = Toml()
    println(bad.parse("x = 2023-02-29\n"))
    println(bad.parse("x = 25:00:00\n"))
}
